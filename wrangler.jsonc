{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minisocial",
	"main": "src/worker/index.ts",
	"vars": { "AUTH_URL": "https://minisocial.yikaus.workers.dev" },
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "minisocial",
			"database_id": "8a5c77bc-e0d6-43ff-b58d-a0b8f6327be5",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "minisocial-media"
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "5e2b1eea1f2543bc848e8220c3a4d4fe"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "EVENTS",
				"queue": "minisocial-events"
			}
		],
		"consumers": [
			{
				"queue": "minisocial-events",
				"max_batch_size": 10,
				"max_retries": 3,
				"dead_letter_queue": "minisocial-events-dlq"
			}
		]
	},
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"unsafe": {
		"bindings": [
			{
				"name": "AUTH_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": {
					"limit": 10,
					"period": 60
				}
			},
			{
				"name": "WRITE_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": {
					"limit": 20,
					"period": 60
				}
			},
			{
				"name": "UPLOAD_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1003",
				"simple": {
					"limit": 10,
					"period": 60
				}
			}
		]
	}
}